# GitHub API Token (unauthenticated is limited to 60 req/hr; token provides 5,000 req/hr)
GITHUB_TOKEN=

# LLM Provider Configuration (gemini | anthropic | openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Caching & Storage
REDIS_URL=
SQLITE_DB_PATH=./data/cache.db
CHROMA_DIR=./data/chroma

# Ingestion Limits & Budgets
MAX_FILES_READ=150
MAX_FILE_BYTES=200000
MAX_REPO_SIZE_MB=500
CONTEXT_TOKEN_BUDGET=30000
ANALYSIS_TIMEOUT_SECONDS=90

# Rate Limiting (per IP)
RATE_LIMIT_ANALYZE_PER_HOUR=5
RATE_LIMIT_CHAT_PER_HOUR=30
CACHE_TTL_HOURS=24

# Networking & Security
FRONTEND_ORIGIN=http://localhost:5173
PROMPT_VERSION=v1
PORT=8000
HOST=0.0.0.0
